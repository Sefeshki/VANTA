<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_overview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="11dp"
    android:paddingRight="12dp"
    android:paddingBottom="11dp">

    <!-- Portrait Header -->
    <LinearLayout
        android:id="@+id/widget_overview_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:letterSpacing="0.16"
                android:maxLines="1"
                android:text="VANTA"
                android:textColor="#FFFFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="OVERVIEW"
                android:textColor="#8A8A93"
                android:textSize="8.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_overview_uptime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="SERVICE IDLE"
            android:textColor="#8A8A93"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="7dp"
        android:background="#1FFFFFFF"
        android:contentDescription="@null" />

    <!-- Stacked Health Telemetry List (portrait-first) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_card_inner"
        android:orientation="vertical"
        android:paddingLeft="9dp"
        android:paddingTop="7dp"
        android:paddingRight="9dp"
        android:paddingBottom="7dp">

        <!-- Internet Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_overview_internet_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="INTERNET"
                android:textColor="#A1A1AA"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/widget_overview_internet_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_inactive" />

            <TextView
                android:id="@+id/widget_overview_internet_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="OFFLINE"
                android:textColor="#71717A"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Telegram Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_overview_telegram_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="TELEGRAM"
                android:textColor="#A1A1AA"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/widget_overview_telegram_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_inactive" />

            <TextView
                android:id="@+id/widget_overview_telegram_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="OFFLINE"
                android:textColor="#71717A"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Service Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_overview_service_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="SERVICE"
                android:textColor="#A1A1AA"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/widget_overview_service_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_inactive" />

            <TextView
                android:id="@+id/widget_overview_service_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="OFF"
                android:textColor="#71717A"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:contentDescription="@null" />

    <!-- SIM 1 Detailed Card -->
    <LinearLayout
        android:id="@+id/widget_overview_sim1_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card_inner"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="9dp"
        android:paddingTop="6dp"
        android:paddingRight="9dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_overview_sim1_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_inactive" />

            <TextView
                android:id="@+id/widget_overview_sim1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="SIM 1"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_overview_sim1_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="OFF"
                android:textColor="#8A8A93"
                android:textSize="8.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_overview_sim1_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:text="Forwarding details"
            android:textColor="#A1A1AA"
            android:textSize="8.5sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:contentDescription="@null" />

    <!-- SIM 2 Detailed Card -->
    <LinearLayout
        android:id="@+id/widget_overview_sim2_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card_inner"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="9dp"
        android:paddingTop="6dp"
        android:paddingRight="9dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_overview_sim2_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_inactive" />

            <TextView
                android:id="@+id/widget_overview_sim2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="SIM 2"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_overview_sim2_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="OFF"
                android:textColor="#8A8A93"
                android:textSize="8.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_overview_sim2_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:text="Forwarding details"
            android:textColor="#A1A1AA"
            android:textSize="8.5sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_overview_footer_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="6dp"
        android:background="#1FFFFFFF"
        android:contentDescription="@null" />

    <!-- Two-Line Portrait Footer Metrics -->
    <LinearLayout
        android:id="@+id/widget_overview_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_overview_delivered"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="SENT: 0"
                android:textColor="#A1A1AA"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_overview_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="QUEUE: 0"
                android:textColor="#8A8A93"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_overview_last_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="LAST: --"
            android:textColor="#8A8A93"
            android:textSize="8.5sp" />
    </LinearLayout>

</LinearLayout>
