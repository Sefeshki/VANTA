<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_overview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="7dp"
    android:paddingRight="10dp"
    android:paddingBottom="7dp">

    <!-- Compact 4x2 Header -->
    <LinearLayout
        android:id="@+id/widget_overview_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:text="VANTA"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="OVERVIEW"
            android:textColor="#8A8A93"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/widget_overview_uptime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="end"
            android:maxLines="1"
            android:text="SERVICE IDLE"
            android:textColor="#8A8A93"
            android:textSize="8.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#1FFFFFFF"
        android:contentDescription="@null" />

    <!-- Horizontal 4x2 Body: Left Health Telemetry + Right SIM 1 / SIM 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Left Column: Health Telemetry Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.95"
            android:background="@drawable/widget_card_inner"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="7dp"
            android:paddingTop="4dp"
            android:paddingRight="7dp"
            android:paddingBottom="4dp">

            <!-- Internet Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_overview_internet_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="INTERNET"
                    android:textColor="#A1A1AA"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/widget_overview_internet_dot"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_dot_inactive" />

                <TextView
                    android:id="@+id/widget_overview_internet_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="OFFLINE"
                    android:textColor="#71717A"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Telegram Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_overview_telegram_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="TELEGRAM"
                    android:textColor="#A1A1AA"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/widget_overview_telegram_dot"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_dot_inactive" />

                <TextView
                    android:id="@+id/widget_overview_telegram_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="OFFLINE"
                    android:textColor="#71717A"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Service Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_overview_service_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="SERVICE"
                    android:textColor="#A1A1AA"
                    android:textSize="8sp" />

                <ImageView
                    android:id="@+id/widget_overview_service_dot"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_dot_inactive" />

                <TextView
                    android:id="@+id/widget_overview_service_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="OFF"
                    android:textColor="#71717A"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:contentDescription="@null" />

        <!-- Right Column: SIM 1 & SIM 2 Cards -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:orientation="vertical">

            <!-- SIM 1 Detailed Card -->
            <LinearLayout
                android:id="@+id/widget_overview_sim1_box"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/widget_card_inner"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="7dp"
                android:paddingTop="3dp"
                android:paddingRight="7dp"
                android:paddingBottom="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_overview_sim1_dot"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_dot_inactive" />

                    <TextView
                        android:id="@+id/widget_overview_sim1_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="3dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="SIM 1"
                        android:textColor="#FFFFFFFF"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_overview_sim1_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="OFF"
                        android:textColor="#8A8A93"
                        android:textSize="7.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_overview_sim1_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="Forwarding details"
                    android:textColor="#A1A1AA"
                    android:textSize="7.5sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:contentDescription="@null" />

            <!-- SIM 2 Detailed Card -->
            <LinearLayout
                android:id="@+id/widget_overview_sim2_box"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/widget_card_inner"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="7dp"
                android:paddingTop="3dp"
                android:paddingRight="7dp"
                android:paddingBottom="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_overview_sim2_dot"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_dot_inactive" />

                    <TextView
                        android:id="@+id/widget_overview_sim2_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="3dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="SIM 2"
                        android:textColor="#FFFFFFFF"
                        android:textSize="8.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_overview_sim2_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="OFF"
                        android:textColor="#8A8A93"
                        android:textSize="7.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_overview_sim2_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="Forwarding details"
                    android:textColor="#A1A1AA"
                    android:textSize="7.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_overview_footer_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="3dp"
        android:background="#1FFFFFFF"
        android:contentDescription="@null" />

    <!-- Single-Line Horizontal 4x2 Footer Metrics -->
    <LinearLayout
        android:id="@+id/widget_overview_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_overview_delivered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="SENT: 0"
            android:textColor="#A1A1AA"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_overview_pending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="QUEUE: 0"
            android:textColor="#8A8A93"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/widget_overview_last_sync"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:gravity="end"
            android:maxLines="1"
            android:text="LAST: --"
            android:textColor="#8A8A93"
            android:textSize="8sp" />
    </LinearLayout>

</LinearLayout>
